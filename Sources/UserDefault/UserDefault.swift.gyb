%{
impl_types = {
  'RawRepresentable': 'RawRepresentableImpl',
  'RawRepresentable & Codable': 'RawRepresentableImpl',
  'Codable': 'CodableImpl',
  'Bool': 'UserDefaultImpl',
  'Int': 'UserDefaultImpl',
  'Float': 'UserDefaultImpl',
  'Double': 'UserDefaultImpl',
  'String': 'UserDefaultImpl',
}
operators = {
  'RawRepresentable': ':',
  'RawRepresentable & Codable': ':',
  'Codable': ':',
  'Bool': '==',
  'Int': '==',
  'Float': '==',
  'Double': '==',
  'String': '==',
}
types = list(impl_types.keys())
docs = {
  'RawRepresentable': [
    'Creates a property that stores a `RawRepresentable` value as its raw value.',
    '',
    '`T.RawValue` must be a property list type, such as `String` or `Int`.',
    'Reading the property returns `wrappedValue` when the key holds no value of',
    "type `T.RawValue`, or a raw value that `T(rawValue:)` rejects. Assigning",
    '`nil` to an optional property removes the key.',
  ],
  'RawRepresentable & Codable': [
    'Creates a property that stores a value that is both `RawRepresentable`',
    'and `Codable` as its raw value.',
    '',
    'Raw-value storage takes precedence over JSON storage. The value is stored',
    'exactly as it would be without its `Codable` conformance, so adding',
    '`Codable` to a raw-value type keeps its stored values readable.',
    '`T.RawValue` must be a property list type, such as `String` or `Int`.',
    'Reading the property returns `wrappedValue` when the key holds no value of',
    "type `T.RawValue`, or a raw value that `T(rawValue:)` rejects. Assigning",
    '`nil` to an optional property removes the key.',
  ],
  'Codable': [
    'Creates a property that stores a `Codable` value as JSON data.',
    '',
    'Reading the property returns `wrappedValue` when the key holds no data, or',
    "data that `JSONDecoder` can't decode as `T`. Assigning `nil` to an optional",
    "property removes the key. Assigning a value that `JSONEncoder` can't encode",
    'leaves the stored value unchanged, and debug builds stop at an assertion.',
  ],
}
for direct_type in ['Bool', 'Int', 'Float', 'Double', 'String']:
  docs[direct_type] = [
    f'Creates a property that stores a `{direct_type}` value directly.',
    '',
    'Reading the property returns `wrappedValue` when the key holds no value',
    f'that can be cast to `{direct_type}`.',
  ]
}%
import class Foundation.UserDefaults

/// A property wrapper that stores a value in `UserDefaults` under a key.
///
/// Declare the property with a key and a default value:
///
///     enum Keys: String {
///       case launchCount
///       case theme
///       case account
///     }
///
///     @UserDefault(key: Keys.launchCount)
///     var launchCount = 0
///
///     @UserDefault(key: Keys.theme)
///     var theme: Theme = .light
///
///     @UserDefault(key: Keys.account)
///     var account: Account? = nil
///
/// The type of the property selects how the value is stored:
///
/// - `Bool`, `Int`, `Float`, `Double`, and `String` values are stored directly.
/// - `RawRepresentable` values are stored as their `rawValue`, which must be a
///   property list type such as `String` or `Int`.
/// - `Codable` values are stored as JSON data.
/// - Values of a type that is both `RawRepresentable` and `Codable`, such as
///   `enum Mode: String, Codable`, are stored as their `rawValue`. Raw-value
///   storage takes precedence over JSON storage.
///
/// Reading the property returns its default value when the key holds no
/// value, or a value that can't be read as `T`, such as data that
/// `JSONDecoder` can't decode as `T`. Assigning `nil` to an optional property
/// removes the key, so later reads also return the default value.
@propertyWrapper
public struct UserDefault<T> {
  
  /// The value stored under the key, or the default value when the key holds
  /// no value that can be read as `T`.
  ///
  /// Setting this property writes the new value immediately. Setting an
  /// optional property to `nil` removes the key.
  public var wrappedValue: T {
    get { impl.object(forKey: key) ?? defaultValue }
    set { impl.set(newValue, forKey: key) }
  }

  var defaultValue: T
  var key: String
  var impl: (any UserDefaultWrapper<T>)
% for type in types:
%     impl_type = impl_types[type]
%     operator = operators[type]

% for line in docs[type]:
  ///${' ' + line if line else ''}
% end
  ///
  /// - Parameters:
  ///   - wrappedValue: The default value, which reading returns when the key
  ///     holds no readable value.
  ///   - key: The key under which to store the value.
  ///   - userDefaults: The defaults database to use. The default is
  ///     `UserDefaults.standard`.
  public init(
    wrappedValue: T,
    key: String,
    userDefaults: UserDefaults = .standard) where T ${operator} ${type}
  {
    self.defaultValue = wrappedValue
    self.key = key
    self.impl = ${impl_type}(userDefaults)
  }
  
% for line in docs[type]:
  ///${' ' + line if line else ''}
% end
  ///
  /// - Parameters:
  ///   - wrappedValue: The default value, which reading returns when the key
  ///     holds no readable value.
  ///   - key: A value whose `String` raw value is the key under which to
  ///     store the value.
  ///   - userDefaults: The defaults database to use. The default is
  ///     `UserDefaults.standard`.
  public init<Key>(
    wrappedValue: T,
    key: Key,
    userDefaults: UserDefaults = .standard) where T ${operator} ${type}, Key: RawRepresentable, Key.RawValue == String
  {
    self.init(wrappedValue: wrappedValue, key: key.rawValue, userDefaults: userDefaults)
  }
% end
}
